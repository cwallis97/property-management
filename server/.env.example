# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://property_management_app:changeme@localhost:5432/property_management
PORT=4000
FIREBASE_PROJECT_ID=your-firebase-project-id

# NODE_ENV — set to "production" in a deployed environment. Controls
# fail-closed CORS (below) and whether HSTS is sent.
NODE_ENV=development

# ── Database TLS ─────────────────────────────────────────────────────
# DB_SSL=true encrypts the connection. When it is on, the server
# certificate is VERIFIED by default. Set DB_SSL_REJECT_UNAUTHORIZED=false
# only for a managed provider that cannot present a verifiable chain, and
# prefer supplying its CA bundle via DB_SSL_CA (the PEM contents, on one
# line with \n escapes, or via your host's multiline secret support).
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins permitted to call the API.
# REQUIRED in production: if NODE_ENV=production and this is unset the
# server refuses to start (it never falls back to allowing all origins).
# In development an unset value permits any local origin for convenience.
# CORS_ORIGIN=https://app.example.com,https://staging.example.com

# ── Rate limiting (IP-based, in-memory, per instance) ────────────────
# RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
# RATE_LIMIT_GLOBAL_MAX=1000       # requests / window / IP across the API
# RATE_LIMIT_STRICT_MAX=100        # tighter budget for /api/search + /api/invites

# ── Request body size ───────────────────────────────────────────────
# Max size of a parsed JSON / urlencoded request body. File uploads are
# handled separately by multer (15 MB per file) and are unaffected.
# JSON_BODY_LIMIT=1mb

# ── Proxy ────────────────────────────────────────────────────────────
# Set when the API runs behind a reverse proxy / load balancer so the
# real client IP (needed by the rate limiter) is read from
# X-Forwarded-For. Use the number of proxy hops, e.g. TRUST_PROXY=1 for a
# single PaaS proxy. Leave unset for local development.
# TRUST_PROXY=1
