# Dedicated test database — MUST be a separate database from the one in
# .env's DATABASE_URL. tests/setup.js refuses to run if this matches
# DATABASE_URL, or if the database name doesn't contain "test".
#
# The database itself must already exist (tests run migrations against it,
# but do not create the database) — see README's Testing section for the
# one-time `createdb` step.
TEST_DATABASE_URL=postgresql://property_management_app:changeme@localhost:5432/property_management_test
